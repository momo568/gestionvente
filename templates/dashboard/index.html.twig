{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
    <div class="container">
        <h2 class="mb-4">Bienvenue dans votre tableau de bord 👋</h2>

        <div class="row">
            <div class="col-md-4">
                <div class="card bg-primary text-white mb-3 shadow">
                    <div class="card-body text-center">
                        <h5>Produits</h5>
                        <h2>{{ nbProduits }}</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card bg-success text-white mb-3 shadow">
                    <div class="card-body text-center">
                        <h5>Commandes</h5>
                        <h2>{{ nbCommandes }}</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card bg-warning text-white mb-3 shadow">
                    <div class="card-body text-center">
                        <h5>Clients</h5>
                        <h2>{{ nbClients }}</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
