{% extends 'base.html.twig' %}

{% block title %}Mes Commandes{% endblock %}

{% block body %}
<div class="container mt-4">
    <h2 class="mb-4 text-primary">📜 Mes Commandes</h2>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% if commandes is empty %}
        <div class="alert alert-info text-center">
            Vous n'avez encore passé aucune commande.
        </div>
    {% else %}
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Statut</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for commande in commandes %}
                    <tr>
                        <td>{{ commande.id }}</td>
                        <td>{{ commande.dateCommande|date('d/m/Y H:i') }}</td>
                        <td>{{ commande.total ?? 'N/A' }} DT</td>

                        <td>
                            {% if commande.statut == 'en attente' %}
                                <span class="badge bg-secondary">En attente</span>
                            {% elseif commande.statut == 'payée' %}
                                <span class="badge bg-primary">Payée</span>
                            {% elseif commande.statut == 'livrée' %}
                                <span class="badge bg-success">Livrée</span>
                            {% else %}
                                <span class="badge bg-warning text-dark">{{ commande.statut }}</span>
                            {% endif %}
                        </td>

                        <td>
                            {% if commande.statut == 'en attente' %}
                                <a href="{{ path('client_paiement', { id: commande.id }) }}" class="btn btn-success btn-sm">
                                    💳 Payer
                                </a>
                            {% else %}
                                <span class="text-muted">Aucune action</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
{% endblock %}
