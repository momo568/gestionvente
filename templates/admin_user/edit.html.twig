{% extends 'base.html.twig' %}

{% block title %}Modifier le rôle{% endblock %}

{% block body %}
<h2>Modifier le rôle de <strong>{{ user.email }}</strong></h2>

<form method="post" class="mt-3">
    <label><input type="checkbox" name="roles[]" value="ROLE_USER" {% if 'ROLE_USER' in user.roles %}checked{% endif %}> ROLE_USER</label><br>
    <label><input type="checkbox" name="roles[]" value="ROLE_ADMIN" {% if 'ROLE_ADMIN' in user.roles %}checked{% endif %}> ROLE_ADMIN</label><br>
    <label><input type="checkbox" name="roles[]" value="ROLE_SUPER_ADMIN" {% if 'ROLE_SUPER_ADMIN' in user.roles %}checked{% endif %}> ROLE_SUPER_ADMIN</label><br>

    <button class="btn btn-success mt-3">💾 Enregistrer</button>
</form>

<a href="{{ path('admin_user_index') }}" class="btn btn-secondary mt-3">⬅ Retour</a>
{% endblock %}
