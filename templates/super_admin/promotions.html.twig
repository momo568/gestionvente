{% extends 'base.html.twig' %}
{% block title %}🎁 Liste des promotions{% endblock %}

{% block body %}
<div class="container mt-4">
    <h2 class="mb-3 text-primary">🎁 Liste des promotions</h2>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <div class="mb-3 text-end">
        <a href="{{ path('super_admin_promo_add') }}" class="btn btn-success">➕ Ajouter une promotion</a>
    </div>

    {% if promotions is empty %}
        <div class="alert alert-info text-center">
            Aucune promotion disponible pour le moment.
        </div>
    {% else %}
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Code</th>
                    <th>Réduction</th>
                    <th>Catégorie</th>
                    <th>Début</th>
                    <th>Fin</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for p in promotions %}
                    <tr>
                        <td>{{ p.id }}</td>
                        <td>{{ p.nom }}</td>
                        <td><span class="badge bg-primary">{{ p.code }}</span></td>
                        <td><strong>{{ p.pourcentage }}%</strong></td>
                        <td>{{ p.category ? p.category.name : 'Toutes les catégories' }}</td>
                        <td>{{ p.dateDebut|date('d/m/Y') }}</td>
                        <td>{{ p.dateFin|date('d/m/Y') }}</td>
                        <td>
                            <a href="{{ path('super_admin_promo_delete', {'id': p.id}) }}"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Supprimer cette promotion ?')">🗑️</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
{% endblock %}
